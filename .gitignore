# Your WhatsApp session. Anyone with this folder can read your
# messages as you. This is the single most important entry here.
chrome_profile/

# Real contact names and your phone number.
contacts.json

# Your parsed chat history and everything learned since.
data/
*.zip
_chat.txt

# Logs contain the text of real messages.
logs/
*.log


